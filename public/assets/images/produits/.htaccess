# Dossier des photos : aucun script ne doit pouvoir s'exécuter ici
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
